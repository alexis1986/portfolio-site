# Time-boxed exceptions for Semgrep.
# Every entry must be preceded by a comment with the reason and an expiry date:
#   # reason — expires YYYY-MM-DD
#   <path or glob>
# An expired entry is a finding to revisit, not a permanent allowance.

# Defaults: vendored/generated output and gitignored files are not scanned; tests stay in scope.
:include .gitignore
node_modules/
dist/
build/
.next/
*.min.js
